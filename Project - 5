#include <stdio.h>
#include <conio.h>

void main()
{
    FILE *fp;
    char name[300];


    // 1. Writing data into file
    fp = fopen("feedback.txt", "w");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        
        return;
    }

    fprintf(fp, "The session was very useful and engaging. The trainer explained C programming concepts in a clear and understandable manner. The examples and practice exercises helped improve my coding skills and confidence.");

    fclose(fp);

    printf("Data written successfully\n");


    // 2. Appending data into file
    fp = fopen("feedback.txt", "a");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        return;
    }

    fprintf(fp, "\nvery super class is c program one of the best subject in c and my fav is c program ");

    fclose(fp);

    printf("Data appended successfully\n");


    // 3. Reading data from file
    fp = fopen("feedback.txt", "r");

    if (fp == NULL)
    {
        printf("File cannot be opened");
       
        return;
    }

    printf("\nFile Contents:\n");

    while (fgets(name, sizeof(name), fp) != NULL)
    {
        printf("%s", name);
    }

    fclose(fp);

    
}
